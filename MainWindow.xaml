<Window x:Class="PST_PasswordRecovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PST Password Recovery"
        Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.PrimaryBg}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderBg}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="PST Password Recovery"
                           Style="{StaticResource HeaderTextStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton" Content="Modo Claro" Click="ToggleThemeClick"
                            Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Terminos" Click="ShowTermsClick"
                            Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Acerca de" Click="ShowAboutClick"
                            Style="{StaticResource SmallButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- File Section -->
            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="ARCHIVO PST" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Selecciona un archivo PST de Outlook para recuperar su contraseña"
                               Style="{StaticResource LabelStyle}"/>

                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Buscar" Click="BrowseClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110" Margin="10,0,0,0"/>
                        <TextBox x:Name="PstPathTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Ejecutar Analisis" Click="ExecuteClick"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="180"/>

                <Button Grid.Column="2" Content="Copiar Clave" Click="CopyKeyClick"
                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="120"/>
            </Grid>

            <!-- Results Section -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RESULTADOS" Style="{StaticResource SectionTitleStyle}"/>
                    <RichTextBox Grid.Row="1" x:Name="DetailsTextBox"
                                 Style="{StaticResource ResultsTextBoxStyle}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.SecondaryBg}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Margin="0,0,0,2">
                        <Hyperlink NavigateUri="https://www.dmdevlabs.com" RequestNavigate="OpenWebsiteLink"
                                   Foreground="{DynamicResource Brush.Accent}" TextDecorations="None">
                            www.dmdevlabs.com
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Open Source - GPL-3.0 | DMDev Labs" FontSize="10"
                               Foreground="{DynamicResource Brush.TextDim}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource Brush.TextDim}" Opacity="0.6">
                    v2.1.1
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
