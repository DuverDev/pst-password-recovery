<Window x:Class="PST_PasswordRecovery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PST Password Recovery"
        Height="720" Width="1160"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        DragOver="WindowDragOver"
        Drop="WindowDrop"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.PrimaryBg}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        StateChanged="WindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootChrome"
            Background="{DynamicResource Brush.PrimaryBg}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Frameless Header (no white Windows bar) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.HeaderBg}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    MouseLeftButtonDown="HeaderMouseDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title + Engine Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentBorder}"
                                BorderThickness="1" Margin="0,0,12,0">
                            <Path Data="M7,14 A5,5 0 1,1 11.9,10 L21,10 L21,14 L18,14 L18,17 L15,17 L15,14 L11.9,14 A5,5 0 0,1 7,14 Z M7,10.5 A1.5,1.5 0 1,0 7,13.5 A1.5,1.5 0 1,0 7,10.5 Z"
                                  Fill="{DynamicResource Brush.AccentText}"
                                  Stretch="Uniform" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="PST Password Recovery"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>

                        <Border Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentBorder}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="10,4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="HeaderEngineBadge"
                                           Text="Motor CRC-32 · 100% Offline"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.AccentText}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.InputBg}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="v2.2.0" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextDim}"/>
                        </Border>
                    </StackPanel>

                    <!-- Toolbar + Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LangToggleButton" Content="EN" MinWidth="42" Click="ToggleLangClick"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="ThemeToggleButton" Content="Modo Oscuro" MinWidth="108" Click="ToggleThemeClick"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="TermsButton" Content="Términos" MinWidth="82" Click="ShowTermsClick"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,0"/>
                        <Button x:Name="AboutButton" Content="Acerca de" MinWidth="86" Click="ShowAboutClick"
                                Style="{StaticResource SmallButtonStyle}" Margin="0,0,12,0"/>

                        <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" Margin="0,0,10,0"/>

                        <Button Content="—" Click="MinimizeClick" Style="{StaticResource WinCtrlButtonStyle}" ToolTip="Minimizar"/>
                        <Button x:Name="MaxButton" Content="□" Click="MaximizeClick" Style="{StaticResource WinCtrlButtonStyle}" ToolTip="Maximizar"/>
                        <Button Content="✕" Click="CloseClick" Style="{StaticResource WinCloseButtonStyle}" ToolTip="Cerrar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2-Column Workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.SecondaryBg}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,18,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Selected File Panel -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="LblSidebarFile" Text="ARCHIVO OUTLOOK PST" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="LblSidebarFileDesc"
                                           Text="Selecciona o arrastra un archivo .pst protegido. Se lee en modo seguro sin modificarlo."
                                           FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource Brush.InputBg}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,9" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedFileNameText" Text="Ningún archivo seleccionado"
                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock x:Name="SelectedFilePathText" Text="Haz clic en Buscar PST o suelta un archivo aquí"
                                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextDim}"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Button x:Name="ExecuteButton" Content="Ejecutar Análisis" Click="ExecuteClick"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                </Grid>
                                <Button x:Name="BrowseButton" Content="Buscar archivo PST..." Click="BrowseClick"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Privacy Guarantees -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="LblSidebarPrivacy" Text="GARANTÍAS DE PRIVACIDAD" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="LblPriv1" Text="100% local en memoria, sin subir datos" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="LblPriv2" Text="Sin conexión a internet ni telemetría" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="LblPriv3" Text="Lee solo propiedad MAPI 0x67FF" FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Session History -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="LblSidebarHistory" Text="HISTORIAL DE SESIÓN" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="HistoryListPanel">
                                        <TextBlock x:Name="HistoryEmptyText"
                                                   Text="Aún no hay análisis en esta sesión."
                                                   FontSize="11.5" Foreground="{DynamicResource Brush.TextDim}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Sidebar Footer -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://www.dmdevlabs.com" RequestNavigate="OpenWebsiteLink"
                                           Foreground="{DynamicResource Brush.AccentText}" TextDecorations="None">
                                    dmdevlabs.com
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="Open Source · GPL-3.0" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Main Workspace -->
                <Grid Grid.Column="1" Margin="22,18,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: 3 Diagnostic KPI Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Structure -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="Kpi1Title" Text="ESTRUCTURA PST" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="Kpi1Value" Text="En espera" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="Kpi1Sub" Text="Cabecera NDB / Message Store" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: CRC32 Hash -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="Kpi2Title" Text="HASH CRC-32 (0x67FF)" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="Kpi2Value" Text="0x--------" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.InfoText}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="Kpi2Sub" Text="Firma débil de Outlook PST" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Collision Status -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="Kpi3Title" Text="COLISIÓN INVERSA" Style="{StaticResource SectionEyebrowStyle}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="Kpi3Value" Text="Listo" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="Kpi3Sub" Text="Motor ASCII reversible" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 1: Hero Recovered Key Banner -->
                    <Border Grid.Row="1" x:Name="KeyHeroBorder"
                            Background="{DynamicResource Brush.CardBg}"
                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="HeroEyebrow" Text="CLAVE RECUPERADA · COLISIÓN CRC-32 VÁLIDA"
                                               Style="{StaticResource SectionEyebrowStyle}"
                                               Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <Border Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="{DynamicResource Brush.AccentBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="0,0,12,0">
                                        <TextBlock x:Name="RecoveredKeyDisplay" Text="——————"
                                                   FontFamily="Consolas" FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.AccentText}"/>
                                    </Border>
                                    <TextBlock x:Name="CopyFeedbackText" Text="" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="HeroExplainText"
                                           Text="Carga un archivo .pst protegido para obtener una contraseña equivalente aceptada por Microsoft Outlook."
                                           FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="CopyButton" Content="Copiar Clave" Click="CopyKeyClick"
                                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="150"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Technical Diagnostic Console -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConsoleTitleText" Text="CONSOLA TÉCNICA DE DIAGNÓSTICO"
                                               Style="{StaticResource SectionEyebrowStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Brush.InputBg}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock x:Name="ConsoleModeBadge" Text="Lectura segura · Sin escritura en .pst"
                                               FontSize="10.5" Foreground="{DynamicResource Brush.TextDim}"/>
                                </Border>
                            </Grid>

                            <RichTextBox Grid.Row="1" x:Name="DetailsTextBox"
                                         Style="{StaticResource ResultsTextBoxStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
